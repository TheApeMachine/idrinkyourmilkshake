{
  "integration": "Shiftbase API Integration",
  "base_url": "https://api.shiftbase.com",
  "auth": {
    "type": "API",
    "outputs": [
      {
        "key": "key",
        "value": "API secretkey123"
      }
    ]
  },
  "jobs": [
    {
      "id": "fetch_absences",
      "steps": [
        {
          "type": "http",
          "id": "step1",
          "endpoint": "/absentees",
          "method": "GET",
          "outputs": [
            {
              "key": "AbsenceId",
              "value": "$.absentees[*].id"
            }
          ],
          "collection": "Absence",
          "operation": "insert",
          "documents": [
            {
              "key": "AbsenceId",
              "value": "$.absentees[*].id"
            },
            {
              "key": "AbsenceStartDate",
              "value": "$.absentees[*].start_date"
            },
            {
              "key": "AbsenceEndDate",
              "value": "$.absentees[*].end_date"
            },
            {
              "key": "AbsenceTypeId",
              "value": "$.absentees[*].type_id"
            },
            {
              "key": "EmployeeId",
              "value": "$.absentees[*].employee_id"
            }
          ]
        }
      ]
    },
    {
      "id": "fetch_shifts",
      "steps": [
        {
          "type": "http",
          "id": "step1",
          "endpoint": "/shifts",
          "method": "GET",
          "outputs": [
            {
              "key": "ShiftId",
              "value": "$.shifts[*].id"
            }
          ],
          "collection": "Shift",
          "operation": "insert",
          "documents": [
            {
              "key": "ExternalShiftId",
              "value": "$.shifts[*].external_id"
            },
            {
              "key": "Description",
              "value": "$.shifts[*].description"
            },
            {
              "key": "Start",
              "value": "$.shifts[*].start"
            },
            {
              "key": "End",
              "value": "$.shifts[*].end"
            },
            {
              "key": "UserId",
              "value": "$.shifts[*].user_id"
            }
          ]
        }
      ]
    }
  ]
}